{
  "name": "@openmetro/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external effect --external elysia && bunx tsc -p tsconfig.json --emitDeclarationOnly --noEmit false --outDir dist",
    "test": "bun test",
    "api": "bun run src/api/server.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@mapbox/vector-tile": "^3.0.0",
    "effect": "^3.22.0",
    "elysia": "^1.4.30",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
