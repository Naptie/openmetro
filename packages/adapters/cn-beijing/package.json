{
  "name": "@openmetro/adapter-cn-beijing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "openmetro": {
    "networkId": "cn-beijing",
    "entry": "./src/adapter.ts",
    "displayName": {
      "zh": "北京",
      "en": "Beijing"
    },
    "cityId": "CN-11"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external @openmetro/core --external fast-xml-parser",
    "normalize": "bun run src/run.ts"
  },
  "dependencies": {
    "effect": "^3.22.0",
    "@openmetro/core": "workspace:*",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
