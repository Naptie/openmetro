{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name",
    "names",
    "city",
    "country_code",
    "currency",
    "timezone",
    "coordinate_system",
    "default_units",
    "routing"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "names": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {
        "zh": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "city": {
      "type": "object",
      "required": ["id", "name", "country", "population", "area", "location"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "object",
          "required": ["zh", "en"],
          "properties": {
            "zh": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "country": {
          "type": "string"
        },
        "population": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "area": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "object",
              "required": ["type", "coordinates"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["Point"]
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 2,
                  "items": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "additionalItems": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "country_code": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "coordinate_system": {
      "type": "string",
      "enum": ["wgs84", "gcj02", "bd09", "schematic", "none"]
    },
    "default_units": {
      "type": "object",
      "required": ["distance", "time", "speed"],
      "properties": {
        "distance": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "speed": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": ["weight", "default_transfer_seconds"],
      "properties": {
        "weight": {
          "type": "string",
          "enum": ["time", "distance"]
        },
        "default_transfer_seconds": {
          "type": "number"
        },
        "max_transfer_seconds": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "topology",
        "coordinates",
        "names",
        "segment_times",
        "segment_distances",
        "transfer_times",
        "timetables",
        "schematic"
      ],
      "properties": {
        "topology": {
          "type": "object",
          "required": ["precision", "coverage", "status", "counts"],
          "properties": {
            "precision": {
              "type": "string",
              "enum": ["official", "derived", "default"]
            },
            "coverage": {
              "type": "number"
            },
            "status": {
              "type": "string",
              "enum": ["complete", "partial", "derived", "unavailable"]
            },
            "counts": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "coordinates": {
          "type": "object",
          "required": ["precision", "coverage", "status", "counts"],
          "properties": {
            "precision": {
              "type": "string",
              "enum": ["official", "derived", "default"]
            },
            "coverage": {
              "type": "number"
            },
            "status": {
              "type": "string",
              "enum": ["complete", "partial", "derived", "unavailable"]
            },
            "counts": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "names": {
          "type": "object",
          "required": ["precision", "coverage", "status", "counts"],
          "properties": {
            "precision": {
              "type": "string",
              "enum": ["official", "derived", "default"]
            },
            "coverage": {
              "type": "number"
            },
            "status": {
              "type": "string",
              "enum": ["complete", "partial", "derived", "unavailable"]
            },
            "counts": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "segment_times": {
          "type": "object",
          "required": ["precision", "coverage", "status", "counts"],
          "properties": {
            "precision": {
              "type": "string",
              "enum": ["official", "derived", "default"]
            },
            "coverage": {
              "type": "number"
            },
            "status": {
              "type": "string",
              "enum": ["complete", "partial", "derived", "unavailable"]
            },
            "counts": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "segment_distances": {
          "type": "object",
          "required": ["precision", "coverage", "status", "counts"],
