            },
            "coverage": {
              "type": "number"
            },
            "status": {
              "type": "string",
              "enum": ["complete", "partial", "derived", "unavailable"]
            },
            "counts": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "transfer_times": {
          "type": "object",
          "required": ["precision", "coverage", "status", "counts"],
          "properties": {
            "precision": {
              "type": "string",
              "enum": ["official", "derived", "default"]
            },
            "coverage": {
              "type": "number"
            },
            "status": {
              "type": "string",
              "enum": ["complete", "partial", "derived", "unavailable"]
            },
            "counts": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "timetables": {
          "type": "object",
