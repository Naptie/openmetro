# Optional: Overpass mirror or a raw OSM response for reproducible enrichment.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OPENMETRO_OSM_FILE=/absolute/path/to/overpass-response.json

# Raw snapshots need an original OSM timestamp no older than 30 days.
# Optional: directory containing eng.traineddata.gz and chi_tra.traineddata.gz for offline OCR.
# OPENMETRO_OCR_MODEL_DIR=/absolute/path/to/ocr-models

# Optional reproducible service date for the Taiwan railway/HSR snapshots.
# Defaults to today's date in Asia/Taipei (not the runner's local timezone).
# OPENMETRO_SERVICE_DATE=2026-10-16

# Bypass the six-hour raw railway resource cache after an upstream correction.
# OPENMETRO_REFRESH=1

# Optional deployed API snapshot location (one complete JSON per network).
# Defaults to the Vercel Git repository's data branch; otherwise Naptie/openmetro.
# OPENMETRO_DATA_URL=https://raw.githubusercontent.com/Naptie/openmetro/data/data/.snapshots/
